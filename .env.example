# Ключ ProxyAPI (https://console.proxyapi.ru)
OPENAI_API_KEY=sk-...

# Ключ подписи сессий. Сгенерировать: openssl rand -hex 32
# Без фиксированного ключа каждый пересоздание контейнера разлогинивает всех.
WEBUI_SECRET_KEY=

# Хост в РФ, через который relay туннелирует запросы к api.proxyapi.ru
# (IPv6-адрес или hostname; нужен SSH-доступ, см. README)
RELAY_HOST=
